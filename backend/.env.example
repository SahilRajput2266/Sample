# Environment: use `development` locally. Production MUST set NODE_ENV=production
# (hides stack traces in API error responses) and MUST use its own strong JWT_SECRET.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/joborbit
# Generate a strong secret (never commit the real value), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_generated_random_secret
CLIENT_URL=http://localhost:5173
AI_PROVIDER=template
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Milestone 6 safe automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=
PLAYWRIGHT_TIMEOUT=30000
AUTOMATION_MAX_RETRIES=2
AUTOMATION_SCREENSHOTS_ENABLED=true
AUTOMATION_AUTO_SUBMIT_ENABLED=false
AUTOMATION_QUEUE_ENABLED=true
AUTOMATION_GLOBAL_CONCURRENCY=2
AUTOMATION_SCREENSHOT_RETENTION_DAYS=30
AUTOMATION_STALE_RUN_HOURS=24
AUTOMATION_TEST_FORM_ENABLED=false
REDIS_URL=
REDIS_TLS=false
REDIS_TLS_SERVERNAME=
REDIS_TLS_REJECT_UNAUTHORIZED=true
AUTOMATION_RUN_TIMEOUT_MS=60000
