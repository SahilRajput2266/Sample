# Environment: use `development` locally. Production MUST set NODE_ENV=production
# (hides stack traces in API error responses) and MUST use its own strong JWT_SECRET.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/joborbit
# Generate a strong secret (never commit the real value), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_generated_random_secret
CLIENT_URL=http://localhost:5173
AI_PROVIDER=template
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
